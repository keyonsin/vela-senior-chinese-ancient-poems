<template>
  <div class="container" onswipe="onSwipe" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
    <div class="header-bar">
      <text class="header-title">{{ sectionTitle }}</text>
    </div>
    <scroll class="scroll-content" scroll-y="true" bounces="true">
      <div class="text-container">
        <text if="{{ !error }}" class="article-text">{{ heading }}</text>
        <text if="{{ loading }}" class="article-text">正在加载</text>
        <text class="article-text" for="{{ blocks }}" tid="id">{{ $item.blank ? "\n" : $item.text }}</text>
        <text if="{{ error }}" class="article-text">{{ error }}</text>
        <div if="{{ error && canRetry }}" class="card-item" onclick="read">
          <text class="card-text">重试</text>
        </div>
        <div if="{{ error }}" class="card-item" onclick="back">
          <text class="card-text">返回</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import { getEntry, getSection } from "../../common/catalog"
import { loadContent } from "../../common/content"
import { makeBlocks } from "../../common/reading"
import { goBack, swipeBack, startBackGesture, moveBackGesture, endBackGesture } from "../../common/navigation"

export default {
  public: {
    bookId: "",
    entryId: "",
    sectionId: ""
  },

  private: {
    title: "",
    author: "",
    heading: "",
    sectionTitle: "阅读",
    blocks: [],
    loading: false,
    error: "",
    canRetry: false,
    navigating: false
  },

  onInit() {
    const entry = getEntry(this.bookId, this.entryId)
    const section = getSection(this.sectionId)
    if (!entry || !section) {
      this.error = "未找到这篇古诗文"
      return
    }
    this.title = entry.title
    this.author = entry.author
    this.heading = `${entry.title}\n【${entry.author}】\n`
    this.sectionTitle = section.title
    this.canRetry = true
    this.read()
  },

  onShow() {
    this.navigating = false
    this.backGesture = null
  },

  read() {
    if (this.loading || !this.canRetry) return
    if (this.cancelLoad) this.cancelLoad()
    this.error = ""
    this.loading = true
    this.blocks = []
    this.cancelLoad = loadContent(
      this.bookId,
      this.entryId,
      this.sectionId,
      paragraphs => {
        this.blocks = makeBlocks(paragraphs, this.sectionId)
        this.loading = false
      },
      message => {
        this.error = message
        this.loading = false
      }
    )
  },

  onDestroy() {
    if (this.cancelLoad) this.cancelLoad()
    this.cancelLoad = null
    this.blocks = []
  },

  back() {
    goBack(this)
  },

  onSwipe(event) {
    swipeBack(this, event)
  },

  onTouchStart(event) {
    startBackGesture(this, event)
  },

  onTouchMove(event) {
    moveBackGesture(this, event)
  },

  onTouchEnd(event) {
    endBackGesture(this, event)
  }
}
</script>

