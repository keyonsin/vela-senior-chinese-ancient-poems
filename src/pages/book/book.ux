<template>
  <div class="container" onswipe="onSwipe" ontouchstart="onTouchStart" ontouchmove="onTouchMove" ontouchend="onTouchEnd">
    <div class="header-bar">
      <text class="header-title">{{ title }}</text>
    </div>
    <scroll class="scroll-content" scroll-y="true" bounces="true">
      <div class="list-wrapper">
        <div class="card-item" for="{{ entries }}" tid="id" onclick="openEntry($item.id)">
          <text class="card-text">{{ $item.title }}</text>
        </div>
        <text if="{{ error }}" class="article-text">{{ error }}</text>
        <div if="{{ error }}" class="card-item" onclick="back">
          <text class="card-text">返回</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import { getBook, getEntry } from "../../common/catalog"
import { openPage, goBack, swipeBack, startBackGesture, moveBackGesture, endBackGesture } from "../../common/navigation"

export default {
  public: {
    bookId: ""
  },

  private: {
    title: "篇目",
    entries: [],
    error: "",
    navigating: false
  },

  onInit() {
    const book = getBook(this.bookId)
    if (!book) {
      this.error = "未找到这册教材"
      return
    }
    this.title = book.title
    this.entries = book.entries
  },

  onShow() {
    this.navigating = false
    this.backGesture = null
  },

  openEntry(entryId) {
    if (!getEntry(this.bookId, entryId)) return
    openPage(this, "/pages/detail", { bookId: this.bookId, entryId })
  },

  back() {
    goBack(this)
  },

  onSwipe(event) {
    swipeBack(this, event)
  },

  onTouchStart(event) {
    startBackGesture(this, event)
  },

  onTouchMove(event) {
    moveBackGesture(this, event)
  },

  onTouchEnd(event) {
    endBackGesture(this, event)
  }
}
</script>

